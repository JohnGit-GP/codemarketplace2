{
  "name": "elastic",
  "cluster": "aks-1",
  "namespace": "elastic",
  "operatorNamespace": "elastic-system",
  "istio": {
    "revision": "asm-1-29"
  },
  "components": [
    {
      "name": "eck-operator",
      "cluster": "aks-1",
      "exposed": false
    },
    {
      "name": "elasticsearch",
      "cluster": "aks-1",
      "exposed": true,
      "host": "elasticsearch.iguana.internal"
    },
    {
      "name": "kibana",
      "cluster": "aks-1",
      "exposed": true,
      "host": "kibana.iguana.internal"
    },
    {
      "name": "metricbeat",
      "cluster": [
        "aks-1",
        "atl-aks",
        "gl-aks"
      ],
      "exposed": false
    },
    {
      "name": "heartbeat",
      "cluster": [
        "aks-1",
        "atl-aks",
        "gl-aks"
      ],
      "exposed": false
    }
  ],
  "tls": {
    "issuer": "Iguana dog-ops Issuing CA",
    "nameConstraint": "iguana.internal",
    "gatewaySecrets": [
      "kibana-tls",
      "elasticsearch-tls",
      "elasticsearch-es-ca"
    ],
    "inCluster": "Elasticsearch: ECK-managed HTTPS, outside the mesh (SAML requires it). Kibana: Istio mTLS STRICT. Gateway re-encrypts to ES using ECK's CA (elasticsearch-es-ca)",
    "gatewaySecretNamespace": "aks-istio-ingress"
  },
  "secrets": [
    {
      "name": "eck-license",
      "namespace": "elastic-system",
      "source": "file:license.json",
      "note": "Enterprise license; required for SAML"
    },
    {
      "name": "eck-trial-license",
      "namespace": "elastic-system",
      "source": "manifests/eck-trial-license.yaml",
      "note": "30-day trial; replaced by eck-license"
    },
    {
      "name": "elasticsearch-es-elastic-user",
      "namespace": "elastic",
      "source": "generated by ECK"
    },
    {
      "name": "entra-saml-metadata",
      "namespace": "elastic",
      "kind": "ConfigMap",
      "source": "file:Entra federation metadata XML (SAML_METADATA_FILE)"
    }
  ]
}
