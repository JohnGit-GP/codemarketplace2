{
  "name": "elastic",
  "cluster": "aks-1",
  "namespace": "elastic",
  "operatorNamespace": "elastic-system",
  "istio": {
    "revision": "asm-1-29"
  },
  "components": [
    { "name": "eck-operator",  "cluster": "aks-1",                  "exposed": false },
    { "name": "elasticsearch", "cluster": "aks-1",                  "exposed": true,  "host": "es-ingest.snail.internal" },
    { "name": "kibana",        "cluster": "aks-1",                  "exposed": true,  "host": "kibana.snail.internal" },
    { "name": "metricbeat",    "cluster": ["aks-1","atl-aks","gl-aks"], "exposed": false },
    { "name": "heartbeat",     "cluster": ["aks-1","atl-aks","gl-aks"], "exposed": false }
  ],
  "tls": {
    "issuer": "Iguana dog-ops Issuing CA",
    "nameConstraint": "snail.internal",
    "gatewaySecrets": ["kibana-tls", "es-ingest-tls"],
    "gatewaySecretNamespace": "aks-istio-ingress"
  },
  "secrets": [
    { "name": "eck-license",     "namespace": "elastic-system", "source": "file:license.json", "note": "Enterprise license; required for SAML" },
    { "name": "elasticsearch-es-elastic-user", "namespace": "elastic", "source": "generated by ECK" }
  ]
}
